# La app de Next.js (apps/web) necesita su PROPIA copia de DATABASE_URL — Next.js solo lee
# archivos .env dentro de apps/web, no los de packages/database. Usa el mismo valor que
# pusiste en packages/database/.env.
DATABASE_URL="postgresql://user:password@localhost:5432/deuna?schema=public"

# Secreto para firmar la cookie de sesión del panel de merchant/admin. Genera uno propio para
# producción, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-secret-change-me-before-production"