{
  "name": "deuna",
  "private": true,
  "version": "0.1.0",
  "description": "DeUna — Tú pide. Nosotros resolvemos. Marketplace de delivery para productos de consumo adulto en República Dominicana.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@deuna/database",
    "db:migrate": "npm run migrate --workspace=@deuna/database",
    "db:seed": "npm run seed --workspace=@deuna/database"
  },
  "engines": {
    "node": ">=18.18"
  }
}
